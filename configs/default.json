{
  "items": [
    {
      "key": "p",
      "type": "group",
      "description": "pane",
      "items": [
        { "key": "v", "type": "tmux", "command": "split-window -h -t {{pane_id}} -c '#{pane_current_path}'", "description": "Split vertical" },
        { "key": "s", "type": "tmux", "command": "split-window -v -t {{pane_id}} -c '#{pane_current_path}'", "description": "Split horizontal" },
        { "key": "h", "type": "tmux", "command": "select-pane -t {{pane_id}} -L", "description": "Select left" },
        { "key": "j", "type": "tmux", "command": "select-pane -t {{pane_id}} -D", "description": "Select down" },
        { "key": "k", "type": "tmux", "command": "select-pane -t {{pane_id}} -U", "description": "Select up" },
        { "key": "l", "type": "tmux", "command": "select-pane -t {{pane_id}} -R", "description": "Select right" },
        { "key": "z", "type": "tmux", "command": "resize-pane -t {{pane_id}} -Z", "description": "Zoom toggle" },
        { "key": "x", "type": "tmux", "command": "confirm-before -t {{client_id}} -p 'Kill pane? (y/n)' 'kill-pane -t {{pane_id}}'", "description": "Kill pane" },
        { "key": "o", "type": "tmux", "command": "last-pane -t {{window_id}}", "description": "Last pane" },
        { "key": "!", "type": "tmux", "command": "break-pane -s {{pane_id}}", "description": "Break to window" },
        { "key": "J", "type": "tmux", "command": "command-prompt -t {{client_id}} -p 'Join from pane:' 'join-pane -t {{pane_id}} -s \"%%\"'", "description": "Join pane" },
        { "key": "m", "type": "tmux", "command": "select-pane -t {{pane_id}} -m", "description": "Mark pane" },
        { "key": "M", "type": "tmux", "command": "select-pane -t {{pane_id}} -M", "description": "Unmark pane" },
        { "key": "{", "type": "tmux", "command": "swap-pane -t {{pane_id}} -U", "description": "Swap up" },
        { "key": "}", "type": "tmux", "command": "swap-pane -t {{pane_id}} -D", "description": "Swap down" },
        { "key": "c", "type": "tmux", "command": "clear-history -t {{pane_id}}", "description": "Clear history" },
        { "key": "q", "type": "tmux", "command": "capture-pane -t {{pane_id}}", "description": "Capture to buffer" },
        { "key": "p", "type": "tmux", "command": "respawn-pane -k -t {{pane_id}}", "description": "Respawn pane" },
        {
          "key": "r",
          "type": "group",
          "description": "resize",
          "items": [
            { "key": "h", "type": "tmux", "command": "resize-pane -t {{pane_id}} -L 5", "description": "Resize left" },
            { "key": "j", "type": "tmux", "command": "resize-pane -t {{pane_id}} -D 5", "description": "Resize down" },
            { "key": "k", "type": "tmux", "command": "resize-pane -t {{pane_id}} -U 5", "description": "Resize up" },
            { "key": "l", "type": "tmux", "command": "resize-pane -t {{pane_id}} -R 5", "description": "Resize right" }
          ]
        }
      ]
    },
    {
      "key": "w",
      "type": "group",
      "description": "window",
      "items": [
        { "key": "n", "type": "tmux", "command": "new-window -t {{session_id}} -c '#{pane_current_path}'", "description": "New window" },
        { "key": "x", "type": "tmux", "command": "confirm-before -t {{client_id}} -p 'Kill window? (y/n)' 'kill-window -t {{window_id}}'", "description": "Kill window" },
        { "key": "r", "type": "tmux", "command": "command-prompt -t {{client_id}} -I '#W' 'rename-window -t {{window_id}} \"%%\"'", "description": "Rename" },
        { "key": "f", "type": "popup", "command": "tmux list-windows -a -F '#S:#I  #{window_name}  [#{pane_current_command}]' | less", "description": "Find window" },
        { "key": "l", "type": "tmux", "command": "last-window -t {{session_id}}", "description": "Last window" },
        { "key": ".", "type": "tmux", "command": "next-window -t {{session_id}}", "description": "Next" },
        { "key": ",", "type": "tmux", "command": "previous-window -t {{session_id}}", "description": "Previous" },
        { "key": "w", "type": "tmux", "command": "choose-tree -t {{pane_id}} -w", "description": "Choose window" },
        { "key": "m", "type": "tmux", "command": "command-prompt -t {{client_id}} -p 'Move to:' 'move-window -s {{window_id}} -t \"%%\"'", "description": "Move window" },
        { "key": "s", "type": "tmux", "command": "command-prompt -t {{client_id}} -p 'Swap with:' 'swap-window -s {{window_id}} -t \"%%\"'", "description": "Swap window" },
        { "key": "R", "type": "tmux", "command": "rotate-window -t {{window_id}}", "description": "Rotate panes" }
      ]
    },
    {
      "key": "s",
      "type": "group",
      "description": "session",
      "items": [
        { "key": "n", "type": "tmux", "command": "command-prompt -t {{client_id}} -p 'New session:' 'new-session -d -s \"%%\" \\; switch-client -c {{client_id}} -t \"%%\"'", "description": "New session" },
        { "key": "d", "type": "tmux", "command": "detach-client -t {{client_id}}", "description": "Detach" },
        { "key": "s", "type": "tmux", "command": "choose-tree -t {{pane_id}} -s", "description": "Choose session" },
        { "key": "w", "type": "tmux", "command": "choose-tree -t {{pane_id}}", "description": "Choose tree" },
        { "key": "r", "type": "tmux", "command": "command-prompt -t {{client_id}} -I '#S' 'rename-session -t {{session_id}} \"%%\"'", "description": "Rename" },
        { "key": "k", "type": "tmux", "command": "confirm-before -t {{client_id}} -p 'Kill session? (y/n)' 'switch-client -c {{client_id}} -n \\; kill-session -t {{session_id}}'", "description": "Kill session" },
        { "key": "l", "type": "popup", "command": "tmux list-sessions | less", "description": "List sessions" },
        { "key": "L", "type": "tmux", "command": "lock-session -t {{session_id}}", "description": "Lock session" },
        { "key": "(", "type": "tmux", "command": "switch-client -c {{client_id}} -p", "description": "Previous session" },
        { "key": ")", "type": "tmux", "command": "switch-client -c {{client_id}} -n", "description": "Next session" }
      ]
    },
    {
      "key": "b",
      "type": "group",
      "description": "buffer",
      "items": [
        { "key": "l", "type": "popup", "command": "tmux list-buffers | less", "description": "List buffers" },
        { "key": "p", "type": "tmux", "command": "paste-buffer -t {{pane_id}}", "description": "Paste" },
        { "key": "c", "type": "tmux", "command": "choose-buffer -t {{pane_id}}", "description": "Choose buffer" },
        { "key": "d", "type": "tmux", "command": "delete-buffer", "description": "Delete buffer" },
        { "key": "s", "type": "tmux", "command": "command-prompt -t {{client_id}} -p 'Save to:' 'save-buffer \"%%\"'", "description": "Save to file" },
        { "key": "L", "type": "tmux", "command": "command-prompt -t {{client_id}} -p 'Load from:' 'load-buffer -t {{client_id}} \"%%\"'", "description": "Load from file" },
        { "key": "v", "type": "popup", "command": "tmux show-buffer | less", "description": "Show buffer" },
        { "key": "y", "type": "tmux", "command": "copy-mode -t {{pane_id}}", "description": "Copy mode" },
        { "key": "C", "type": "tmux", "command": "capture-pane -t {{pane_id}}", "description": "Capture pane" }
      ]
    },
    {
      "key": "l",
      "type": "group",
      "description": "layout",
      "items": [
        { "key": "n", "type": "tmux", "command": "next-layout -t {{window_id}}", "description": "Next layout" },
        { "key": "p", "type": "tmux", "command": "previous-layout -t {{window_id}}", "description": "Previous layout" },
        { "key": "1", "type": "tmux", "command": "select-layout -t {{window_id}} even-horizontal", "description": "Even horizontal" },
        { "key": "2", "type": "tmux", "command": "select-layout -t {{window_id}} even-vertical", "description": "Even vertical" },
        { "key": "3", "type": "tmux", "command": "select-layout -t {{window_id}} main-horizontal", "description": "Main horizontal" },
        { "key": "4", "type": "tmux", "command": "select-layout -t {{window_id}} main-vertical", "description": "Main vertical" },
        { "key": "5", "type": "tmux", "command": "select-layout -t {{window_id}} tiled", "description": "Tiled" }
      ]
    },
    {
      "key": "C",
      "type": "group",
      "description": "client",
      "items": [
        { "key": "l", "type": "popup", "command": "tmux list-clients | less", "description": "List clients" },
        { "key": "c", "type": "tmux", "command": "choose-client -t {{pane_id}}", "description": "Choose client" },
        { "key": "d", "type": "tmux", "command": "detach-client -t {{client_id}}", "description": "Detach" },
        { "key": "D", "type": "tmux", "command": "choose-client -t {{pane_id}} -Z \"detach-client -t '%%'\"", "description": "Detach other" },
        { "key": "r", "type": "tmux", "command": "refresh-client -t {{client_id}}", "description": "Refresh" },
        { "key": "s", "type": "tmux", "command": "suspend-client -t {{client_id}}", "description": "Suspend" },
        { "key": "L", "type": "tmux", "command": "lock-client -t {{client_id}}", "description": "Lock" }
      ]
    },
    {
      "key": "o",
      "type": "group",
      "description": "options",
      "items": [
        { "key": "g", "type": "popup", "command": "tmux show-options -g | less", "description": "Show global options" },
        { "key": "w", "type": "popup", "command": "tmux show-window-options -g | less", "description": "Show window options" },
        { "key": "e", "type": "popup", "command": "tmux show-environment -g | less", "description": "Show environment" },
        { "key": "s", "type": "tmux", "command": "command-prompt -t {{client_id}} -p 'Set option:,Value:' 'set-option -g \"%1\" \"%2\"'", "description": "Set global option" },
        { "key": "c", "type": "tmux", "command": "customize-mode -t {{pane_id}} -Z", "description": "Customize mode" },
        { "key": "m", "type": "popup", "command": "tmux show-messages -t '{{client_id}}' | less", "description": "Show messages" },
        { "key": "k", "type": "popup", "command": "tmux list-commands | less", "description": "List commands" }
      ]
    },
    {
      "key": "g",
      "type": "group",
      "description": "git",
      "items": [
        { "key": "s", "type": "action", "command": "git status", "description": "Status", "immediate": true },
        { "key": "d", "type": "action", "command": "git diff", "description": "Diff", "immediate": true },
        { "key": "l", "type": "action", "command": "git log --oneline -20", "description": "Log (20)", "immediate": true },
        { "key": "p", "type": "action", "command": "git push", "description": "Push", "immediate": true },
        { "key": "P", "type": "action", "command": "git pull", "description": "Pull", "immediate": true },
        { "key": "b", "type": "action", "command": "git branch -a", "description": "Branches", "immediate": true },
        { "key": "f", "type": "action", "command": "git fetch --all", "description": "Fetch all", "immediate": true },
        { "key": "a", "type": "action", "command": "git add -p", "description": "Add (patch)" },
        { "key": "c", "type": "action", "command": "git commit", "description": "Commit" },
        { "key": "r", "type": "action", "command": "git rebase --continue", "description": "Rebase continue" }
      ]
    },
    { "key": ":", "type": "tmux", "command": "command-prompt -t {{client_id}}", "description": "Command prompt" },
    { "key": "r", "type": "tmux", "command": "source-file ~/.tmux.conf \\; display-message -t {{pane_id}} 'Config reloaded'", "description": "Reload config" },
    { "key": "?", "type": "popup", "command": "tmux list-keys | less", "description": "List keybindings" },
    { "key": "c", "type": "action", "command": "clear", "description": "Clear screen", "immediate": true },
    { "key": "t", "type": "tmux", "command": "clock-mode -t {{pane_id}}", "description": "Clock mode" },
    { "key": "d", "type": "tmux", "command": "display-panes -t {{client_id}}", "description": "Display panes" }
  ]
}
